}\if{html}{\out{</div>}}
\item Visualise:

\if{html}{\out{<div class="sourceCode r">}}\preformatted{plot(fit, coef = "qvar", what = "coef", engine = "plot3D")
Int.plot(fit, coef = "qvar", what = "coef")
}\if{html}{\out{</div>}}
}
}

